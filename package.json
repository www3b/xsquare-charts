{
    "name": "xsquare-charts",
    "description": "",
    "version": "0.0.0-beta",
    "type": "module",
    "sideEffects": [
        "./auto/auto.js",
        "./auto/auto.cjs",
        "./dist/chart.umd.min.js",
        "./dist/chart.umd.js"
    ],
    "jsdelivr": "./dist/chart.umd.min.js",
    "unpkg": "./dist/chart.umd.min.js",
    "main": "./dist/chart.cjs",
    "module": "./dist/chart.js",
    "exports": {
        ".": {
            "types": "./dist/types.d.ts",
            "import": "./dist/chart.js",
            "require": "./dist/chart.cjs"
        },
        "./auto": {
            "types": "./auto/auto.d.ts",
            "import": "./auto/auto.js",
            "require": "./auto/auto.cjs"
        },
        "./helpers": {
            "types": "./helpers/helpers.d.ts",
            "import": "./helpers/helpers.js",
            "require": "./helpers/helpers.cjs"
        }
    },
    "types": "./dist/types.d.ts",
    "files": [
        "auto/**",
        "dist/**",
        "helpers/**"
    ],
    "scripts": {
        "dev": "node scripts/dev-server.mjs",
        "test:svg": "pnpm build && node --test tests/*.test.mjs",
        "autobuild": "rollup -c -w",
        "copyDeclarations": "node -e \"fs.cpSync('./src/types/', './dist/types/', {recursive:true})\"",
        "emitDeclarations": "tsc --emitDeclarationOnly && pnpm copyDeclarations",
        "build": "rollup -c && pnpm emitDeclarations",
        "lint-js": "eslint \"src/**/*.{js,ts}\" --cache",
        "lint-md": "eslint \"**/*.md\" --cache",
        "lint": "pnpm run lint-js && pnpm run lint-md"
    },
    "dependencies": {
        "@kurkle/color": "^0.3.0"
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^23.0.2",
        "@rollup/plugin-inject": "^5.0.2",
        "@rollup/plugin-json": "^5.0.1",
        "@rollup/plugin-node-resolve": "^15.0.1",
        "@swc/core": "^1.3.18",
        "@types/estree": "^1.0.0",
        "@types/offscreencanvas": "^2019.7.0",
        "@typescript-eslint/eslint-plugin": "^5.32.0",
        "@typescript-eslint/parser": "^5.32.0",
        "eslint": "^8.21.0",
        "eslint-config-chartjs": "^0.3.0",
        "eslint-plugin-es": "^4.1.0",
        "eslint-plugin-markdown": "^3.0.0",
        "rollup": "^3.3.0",
        "rollup-plugin-cleanup": "^3.2.1",
        "rollup-plugin-swc3": "^0.7.0",
        "rollup-plugin-terser": "^7.0.2",
        "typescript": "^4.7.4"
    },
    "engines": {
        "pnpm": ">=8"
    },
    "packageManager": "pnpm@8.13.0",
    "pnpm": {
        "overrides": {
            "html-entities": "1.4.0"
        },
        "peerDependencyRules": {
            "ignoreMissing": [
                "xsquare-charts"
            ]
        }
    }
}
